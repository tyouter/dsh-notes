{
  "name": "@tyouter/dsh-notes",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "A notebook inside DeepSeek Harness: type into one box, read the typeset result beside it, then structure or translate it with AI.",
  "license": "MIT",
  "author": "tyouter <tyouter@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyouter/dsh-notes.git"
  },
  "homepage": "https://github.com/tyouter/dsh-notes#readme",
  "bugs": {
    "url": "https://github.com/tyouter/dsh-notes/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "notes",
    "notebook",
    "markdown",
    "writing"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "src",
    "build.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node tools/check-sources.mjs",
    "test": "node tools/check-sources.mjs && node build.mjs && node test/host.mjs && node test/prompts.mjs && node test/api.mjs && node test/render.mjs && node test/markdown.mjs && node test/document.mjs && node test/typing.mjs && node test/layout.mjs && node test/mirror.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
